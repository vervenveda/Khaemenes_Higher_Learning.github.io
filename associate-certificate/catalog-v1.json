  "title": "Khaemenes Higher Learning Associate-Level Certificate",
  "credential": {
    "type": "free non-accredited educational certificate",
    "level": "associate-level / first-two-years-of-bachelor-preparation",
    "duration": "2 years / 4 terms",
    "total_learning_units": 60,
    "learning_unit_definition": "One certificate learning unit represents approximately 15 hours of documented study, practice, assessment, project, laboratory, studio, field, or supervised learning evidence. Learning units are internal Khaemenes measures, not institutional college credits.",
    "transfer_statement": "This certificate is not an accredited degree, does not itself award college credit, and does not guarantee transfer or admission. Learners may preserve course maps, assessments, projects, portfolios, laboratory records, and completion evidence for review by a future school, employer, or credential evaluator.",
    "tuition": "free",
    "mastery_floor_percent": 80,
    "completion_rule": "All required core and concentration learning units, required practical/lab/studio evidence, corrections below mastery, portfolio artifacts, and the final integrative capstone must be completed and reviewed."
  },
  "structure": {
    "shared_collegiate_core": 24,
    "concentration_study": 30,
    "integrative_capstone": 6,
    "terms": 4,
    "suggested_term_load": 15
  },
  "status_legend": {
    "full": "Standalone instructional course/package is available.",
    "instructional": "Instructional course or workshop exists but may need associate-certificate packaging or expanded assessment evidence.",
    "pathway": "Structured pathway exists inside a learning hall; not independently verified as a standalone course.",
    "resource": "Resource or research hall supports study but is not a course by itself.",
    "scaffold": "Course shell/course map exists but the full instructional package is not yet complete.",
    "composed": "Certificate course-equivalent intentionally combines multiple existing resources and requires a certificate-specific assessment wrapper."
  },
